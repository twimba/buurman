      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "S3 P95 Latency",
      "type": "stat",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(buurman_s3_operation_seconds_bucket{job=\"$job\"}[$__rate_interval])))", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
