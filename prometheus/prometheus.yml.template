global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: 'buurman-prometheus'

# Alertmanager configuration (optional)
# alerting:
#   alertmanagers:
#     - static_configs:
#         - targets:
#           - 'alertmanager:9093'

# Load rules once and periodically evaluate them
# rule_files:
#   - "alerts.yml"

# Scrape configurations
scrape_configs:
  # Prometheus self-monitoring
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Backend Spring Boot actuator metrics.
  # @@BACKEND_METRICS_TARGET@@ is substituted at container startup (see docker-entrypoint.sh).
  # Actuator runs on the separate management port 8082 (management.server.port).
  # Local (make up):  host.docker.internal:8082 (backend publishes 8082 to host)
  # Local (make dev): host.docker.internal:<MANAGEMENT_SERVER_PORT> (e.g. 8183 in a w1 workspace)
  # Production:       injected by Dokploy (e.g. buurman-api-xxx:8082)
  - job_name: 'backend'
    metrics_path: /actuator/prometheus
    scrape_interval: 30s
    static_configs:
      - targets: ['@@BACKEND_METRICS_TARGET@@']

  - job_name: 'postgres-exporter'
    scrape_interval: 30s
    static_configs:
      - targets: ['@@POSTGRES_EXPORTER_TARGET@@']

  # Hetzner Cloud node discovery.
  # @@HETZNER_BEARER_TOKEN@@ is substituted at container startup (see docker-entrypoint.sh).
  # Only active when HETZNER_BEARER_TOKEN is set (production via Dokploy).
  # In local dev this job will fail to scrape but Prometheus will continue normally.
  - job_name: 'hetzner-nodes'
    hetzner_sd_configs:
      - bearer_token: "@@HETZNER_BEARER_TOKEN@@"
        role: "hcloud"
        refresh_interval: 5m
    relabel_configs:
      - source_labels: [__meta_hetzner_hcloud_labelpresent_buurman]
        regex: 'true'
        action: keep
      - source_labels: [__meta_hetzner_public_ipv4]
        regex: '(.*)'
        target_label: __address__
        replacement: '${1}:9100'
      - source_labels: [__meta_hetzner_server_name]
        target_label: instance
      - action: labelmap
        regex: __meta_hetzner_server_label_(.+)

