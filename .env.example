# =============================================================================
# Buurman Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All dev defaults below work out of the box for local development.
#
# For parallel workspaces (Conductor), run: ./scripts/setup-workspace.sh <1-9>
# This generates a .env with workspace-specific ports and hostnames.
# =============================================================================

# --- Workspace (parallel instance support) ---
# Default values work for the base (single) instance. Override via setup-workspace.sh.
COMPOSE_PROJECT_NAME=buurman
HOSTNAME_PREFIX=
HTTP_PORT=80
HTTPS_PORT=443
PG_HOST_PORT=5432
TRAEFIK_DASHBOARD_PORT=8082
SMTP_HOST_PORT=1025
BACKEND_HOST_PORT=8081
BACKEND_MGMT_HOST_PORT=8082
LOCAL_BACKEND_PORT=8081
LOCAL_APP_PORT=5173
LOCAL_BACKOFFICE_PORT=5174

# --- Database (PostgreSQL) ---
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=admin
DB_USERNAME=buurman
DB_PASSWORD=buurman
DB_KEYCLOAK_USERNAME=keycloak
DB_KEYCLOAK_PASSWORD=keycloak

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli

# --- AWS / S3 (AWRust for development) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_REGION=eu-west-1
AWS_S3_BUCKET=buurman-documents

# --- Demo Data ---
DEMO_DATA_ENABLED=true
DEMO_DATA_API_KEY=demo-secret-key

# --- Email ---
EMAIL_FROM=noreply@buurman.io
EMAIL_FROM_NAME=Buurman

# --- App ---
APP_BASE_URL=https://app.local.buurman.io
VITE_KEYCLOAK_URL=https://keycloak.local.buurman.io
VITE_KEYCLOAK_REALM=buurman
VITE_KEYCLOAK_CLIENT_ID=buurman-web
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# Optional Google Maps channel for usage segmentation (0-999)
VITE_GOOGLE_MAPS_CHANNEL=101

# --- Google Maps (Backend Geocoding) ---
GOOGLE_MAPS_API_KEY=your-other-google-maps-api-key-here

# --- Backoffice ---
VITE_BACKOFFICE_KEYCLOAK_URL=https://keycloak.local.buurman.io
VITE_BACKOFFICE_KEYCLOAK_REALM=buurman-backoffice
VITE_BACKOFFICE_KEYCLOAK_CLIENT_ID=buurman-backoffice-web

# --- PostHog (Analytics) ---
# Leave VITE_POSTHOG_KEY empty to disable analytics in local dev.
# VITE_POSTHOG_HOST=/ingest routes through Traefik proxy to PostHog Cloud EU.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=/ingest

VITE_ENVIRONMENT=local

CORS_BACKOFFICE_ALLOWED_ORIGINS=http://localhost:5174,https://backoffice.local.buurman.io

# --- Monitoring SSO (Grafana via Keycloak) ---
GRAFANA_OAUTH_CLIENT_SECRET=grafana-secret

# --- Prometheus ---
# Backend scrape target. Overridden per environment (see docker-compose.dev.yml for make dev).
# Production: set via Dokploy to the actual container name (e.g. buurman-api-xxx:8081)
BACKEND_METRICS_TARGET=backend:8081
# Hetzner Cloud API token for node discovery (production only; leave empty for local dev)
HETZNER_BEARER_TOKEN=

GH_PERSONAL_ACCESS_TOKEN=Github-token
