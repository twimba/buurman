{
  "name": "buurman-app",
  "version": "0.104.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check:locales": "node scripts/check-locale-parity.mjs"
  },
  "dependencies": {
    "@buurman/ui": "workspace:*",
    "@floating-ui/dom": "1.8.0",
    "@tanstack/react-query": "5.104.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-font-family": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extension-underline": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@use-gesture/react": "10.3.1",
    "@vis.gl/react-google-maps": "1.10.1",
    "axios": "1.20.0",
    "date-fns": "4.4.0",
    "dompurify": "3.4.16",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.2",
    "ical.js": "2.2.1",
    "keycloak-js": "26.2.4",
    "libphonenumber-js": "1.13.14",
    "lucide-react": "1.50.0",
    "posthog-js": "1.435.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-is": "19.3.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "swagger-ui-react": "5.33.1"
