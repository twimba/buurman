<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.0.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.0.0
       https://maven.apache.org/xsd/build-cache-config-1.0.0.xsd">

    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
        <local>
            <maxBuildsCached>10</maxBuildsCached>
        </local>
    </configuration>

    <input>
        <global>
            <glob>{*.java,*.xml,*.sql,*.yaml,*.yml,*.properties}</glob>
            <excludes>
                <exclude>target/**</exclude>
            </excludes>
        </global>
    </input>

    <executionControl>
        <runAlways>
            <plugins>
                <plugin artifactId="spotless-maven-plugin"/>
                <plugin artifactId="git-commit-id-maven-plugin"/>
            </plugins>
        </runAlways>
    </executionControl>

</cache>
