        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.buurman</groupId>
            <artifactId>buurman-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Test-scoped dependencies are not transitive, so the integration base class
             pulled in from buurman-core's test-jar needs these declared here too. -->
