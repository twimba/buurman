            <!--
                OpenAPI Code Generation (API-first)
                Generates Spring controller interfaces from OpenAPI specs.
                Controllers implement these interfaces; DTOs are handwritten
                and mapped via importMappings/schemaMappings.
            -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.20.0</version>
