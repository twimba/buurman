<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [reqId='%X{requestId}', userId='%X{userId}'] - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="prod">
        <appender name="Logtail" class="com.logtail.logback.LogtailAppender">
            <appName>${LOGTAIL_APP_NAME:-buurman-backend}</appName>
            <sourceToken>${LOGTAIL_SOURCE_TOKEN}</sourceToken>
            <ingestUrl>${LOGTAIL_INGEST_URL}</ingestUrl>
            <mdcFields>requestId,userId,teamId,userEmail</mdcFields>
            <mdcTypes>string,string,string,string</mdcTypes>
            <objectMapperModule>com.fasterxml.jackson.datatype.jsr310.JavaTimeModule</objectMapperModule>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="Logtail"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.buurman" level="DEBUG"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.jooq" level="INFO"/>
    <logger name="org.jooq.tools.LoggerListener" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>

    <!--
        Google API client must NEVER be raised to DEBUG/CONFIG: those levels log full HTTP
        request/response bodies including the Authorization: Bearer <token> header used for
        Google Sheets exports. Pinned to WARN to keep OAuth access tokens out of logs.
    -->
    <logger name="com.google.api.client.http" level="WARN"/>
    <logger name="com.google.api.client.http.HttpTransport" level="WARN"/>
    <logger name="com.google.auth" level="WARN"/>
</configuration>
