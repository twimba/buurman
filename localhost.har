          "content": {
            "size": 8382,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n    <meta name=\"robots\" content=\"noindex, nofollow\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n            <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>\n    <title>Sign in to Buurman</title>\n    <link rel=\"icon\" href=\"/resources/cedyj/login/buurman/img/favicon.ico\" />\n            <link href=\"/resources/cedyj/common/keycloak/vendor/patternfly-v4/patternfly.min.css\" rel=\"stylesheet\" />\n            <link href=\"/resources/cedyj/common/keycloak/vendor/patternfly-v3/css/patternfly.min.css\" rel=\"stylesheet\" />\n            <link href=\"/resources/cedyj/common/keycloak/vendor/patternfly-v3/css/patternfly-additions.min.css\" rel=\"stylesheet\" />\n            <link href=\"/resources/cedyj/common/keycloak/lib/pficon/pficon.css\" rel=\"stylesheet\" />\n            <link href=\"/resources/cedyj/login/buurman/css/styles.css\" rel=\"stylesheet\" />\n</head>\n\n<body>\n  <div class=\"kc-page-container\">\n    <!-- Left Side - Branding (hidden on mobile) -->\n    <div class=\"kc-branding-panel\">\n      <div class=\"kc-branding-content\">\n        <div class=\"kc-branding-header\">\n          <img src=\"/resources/cedyj/login/buurman/img/logo_square.png\" alt=\"Buurman\" class=\"kc-branding-logo\" />\n          <h1 class=\"kc-branding-title\">Buurman</h1>\n        </div>\n        <p class=\"kc-branding-tagline\">Property management made simple for small landlords</p>\n\n        <!-- Features -->\n        <div class=\"kc-features\">\n          <div class=\"kc-feature\">\n            <div class=\"kc-feature-icon\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/><polyline points=\"9 22 9 12 15 12 15 22\"/></svg>\n            </div>\n            <div class=\"kc-feature-text\">\n              <h3>Manage Properties</h3>\n              <p>Keep track of all your rental properties in one place</p>\n            </div>\n          </div>\n\n          <div class=\"kc-feature\">\n            <div class=\"kc-feature-icon\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg>\n            </div>\n            <div class=\"kc-feature-text\">\n              <h3>Track Tenants</h3>\n              <p>Manage tenant information and lease agreements</p>\n            </div>\n          </div>\n\n          <div class=\"kc-feature\">\n            <div class=\"kc-feature-icon\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>\n            </div>\n            <div class=\"kc-feature-text\">\n              <h3>Handle Finances</h3>\n              <p>Monitor payments, expenses, and financial reports</p>\n            </div>\n          </div>\n\n          <div class=\"kc-feature\">\n            <div class=\"kc-feature-icon\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"/><polyline points=\"16 7 22 7 22 13\"/></svg>\n            </div>\n            <div class=\"kc-feature-text\">\n              <h3>Grow Your Business</h3>\n              <p>Scale your rental portfolio with confidence</p>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"kc-branding-footer\">\n          © 2026 Buurman. Simple property management.\n        </div>\n      </div>\n    </div>\n\n    <!-- Right Side - Login Form -->\n    <div class=\"kc-form-panel\">\n      <div class=\"kc-form-container\">\n        <!-- Mobile Logo (shown only on mobile) -->\n        <div class=\"kc-mobile-logo\">\n          <img src=\"/resources/cedyj/login/buurman/img/logo_square.png\" alt=\"Buurman\" class=\"kc-mobile-logo-img\" />\n          <h1 class=\"kc-mobile-title\">Buurman</h1>\n          <p class=\"kc-mobile-tagline\">Property management for small landlords</p>\n        </div>\n\n        <div class=\"kc-card\">\n          <div class=\"kc-card-header\">\n        <h2 class=\"kc-page-title\">Welcome back</h2>\n        <p class=\"kc-page-subtitle\">Sign in to manage your properties</p>\n\n          </div>\n\n\n    <div id=\"kc-form\">\n      <div id=\"kc-form-wrapper\">\n            <form id=\"kc-form-login\" onsubmit=\"login.disabled = true; return true;\" action=\"http://localhost:8080/realms/buurman/login-actions/authenticate?session_code=_Mh79rVumfjhmJKs69-_R3hUXPgbmGldkpUlIxoiCBA&amp;execution=e69c1a61-f948-4ddf-b018-81e3a05bcc57&amp;client_id=buurman-web&amp;tab_id=etyVdQgncXA&amp;client_data=eyJydSI6Imh0dHA6Ly9sb2NhbGhvc3Q6NTE3My9yZWdpc3RlciIsInJ0IjoiY29kZSIsInJtIjoiZnJhZ21lbnQiLCJzdCI6ImE1ZGZmOTY1LTJiM2YtNDZiOC04ZDM5LWU0Yzc5N2U2ZmNhZiJ9\" method=\"post\">\n                <div class=\"kc-form-group\">\n                    <label for=\"username\" class=\"kc-label\">\n                        Email\n                    </label>\n\n                    <input tabindex=\"1\" id=\"username\" class=\"kc-input\" name=\"username\" value=\"\"  type=\"text\" autofocus autocomplete=\"username\"\n                           aria-invalid=\"\"\n                           placeholder=\"Email\"\n                    />\n\n\n                </div>\n\n                <div class=\"kc-form-group\">\n                    <label for=\"password\" class=\"kc-label\">Password</label>\n\n                    <input tabindex=\"2\" id=\"password\" class=\"kc-input\" name=\"password\" type=\"password\" autocomplete=\"current-password\"\n                           aria-invalid=\"\"\n                           placeholder=\"Enter your password\"\n                    />\n\n\n                </div>\n\n                <div class=\"kc-form-group kc-form-options-wrapper\">\n                    <div class=\"kc-form-options\">\n                            <div class=\"kc-checkbox\">\n                                <label>\n                                        <input tabindex=\"3\" id=\"rememberMe\" name=\"rememberMe\" type=\"checkbox\"> Remember me\n                                </label>\n                            </div>\n                        </div>\n                        <div class=\"kc-forgot-password\">\n                                <a tabindex=\"5\" href=\"/realms/buurman/login-actions/reset-credentials?client_id=buurman-web&amp;tab_id=etyVdQgncXA&amp;client_data=eyJydSI6Imh0dHA6Ly9sb2NhbGhvc3Q6NTE3My9yZWdpc3RlciIsInJ0IjoiY29kZSIsInJtIjoiZnJhZ21lbnQiLCJzdCI6ImE1ZGZmOTY1LTJiM2YtNDZiOC04ZDM5LWU0Yzc5N2U2ZmNhZiJ9\" class=\"kc-link\">Forgot Password?</a>\n                        </div>\n                  </div>\n\n                  <div class=\"kc-form-buttons\">\n                        <input type=\"hidden\" id=\"id-hidden-input\" name=\"credentialId\" />\n                        <button tabindex=\"4\" class=\"kc-button-primary\" name=\"login\" id=\"kc-login\" type=\"submit\">\n                            <svg class=\"kc-button-icon\" xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4\"/><polyline points=\"10 17 15 12 10 7\"/><line x1=\"15\" y1=\"12\" x2=\"3\" y2=\"12\"/></svg>\n                            Sign In\n                        </button>\n                  </div>\n            </form>\n        </div>\n      </div>\n\n\n\n              <div class=\"kc-registration\">\n                      <span>Don't have an account? <a href=\"http://localhost:5173/register\" class=\"kc-link\">Create one here</a></span>\n              </div>\n\n          <div class=\"kc-security-note\">\n            Secure authentication\n          </div>\n\n        </div>\n\n        <!-- Additional Info -->\n        <div class=\"kc-help-link\">\n          Need help? <a href=\"#\" class=\"kc-link\">Contact support</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</body>\n</html>\n"
          },
