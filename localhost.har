            "text": "/* Buurman Keycloak Theme - Professional Two-Column Design */\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Roboto\", \"Oxygen\", \"Ubuntu\", \"Cantarell\", \"Fira Sans\", \"Droid Sans\", \"Helvetica Neue\", sans-serif;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  min-height: 100vh;\n  background: linear-gradient(to bottom right, #eff6ff, #ffffff, #eff6ff);\n}\n\n/* Main Container - Two Column Layout */\n.kc-page-container {\n  display: flex;\n  min-height: 100vh;\n}\n\n/* Left Side - Branding Panel */\n.kc-branding-panel {\n  display: none; /* Hidden on mobile */\n  width: 50%;\n  background: linear-gradient(to bottom right, #2563eb, #1e40af);\n  padding: 3rem;\n  color: white;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n@media (min-width: 1024px) {\n  .kc-branding-panel {\n    display: flex;\n  }\n}\n\n.kc-branding-content {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  height: 100%;\n}\n\n.kc-branding-header {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  margin-bottom: 2rem;\n}\n\n.kc-branding-logo {\n  height: 5rem;\n  width: 5rem;\n  border-radius: 0.75rem;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);\n  border: 4px solid rgba(255, 255, 255, 0.3);\n}\n\n.kc-branding-title {\n  font-size: 2.25rem;\n  font-weight: 900;\n  margin: 0;\n  letter-spacing: -0.025em;\n  background: linear-gradient(to right, #ffffff, #bfdbfe);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.kc-branding-tagline {\n  font-size: 1.25rem;\n  color: #bfdbfe;\n  margin-bottom: 3rem;\n}\n\n/* Features Section */\n.kc-features {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  margin-bottom: auto;\n}\n\n.kc-feature {\n  display: flex;\n  align-items: flex-start;\n  gap: 1rem;\n}\n\n.kc-feature-icon {\n  background-color: rgba(59, 130, 246, 0.3);\n  padding: 0.75rem;\n  border-radius: 0.5rem;\n  flex-shrink: 0;\n}\n\n.kc-feature-icon svg {\n  width: 1.5rem;\n  height: 1.5rem;\n}\n\n.kc-feature-text h3 {\n  font-size: 1.125rem;\n  font-weight: 600;\n  margin-bottom: 0.25rem;\n}\n\n.kc-feature-text p {\n  color: #bfdbfe;\n  font-size: 0.875rem;\n}\n\n.kc-branding-footer {\n  font-size: 0.875rem;\n  color: #bfdbfe;\n  margin-top: 2rem;\n}\n\n/* Right Side - Form Panel */\n.kc-form-panel {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2rem;\n}\n\n.kc-form-container {\n  width: 100%;\n  max-width: 28rem;\n}\n\n/* Mobile Logo (shown only on small screens) */\n.kc-mobile-logo {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  margin-bottom: 2rem;\n}\n\n@media (min-width: 1024px) {\n  .kc-mobile-logo {\n    display: none;\n  }\n}\n\n.kc-mobile-logo-img {\n  height: 6rem;\n  width: 6rem;\n  border-radius: 0.75rem;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.1);\n  margin-bottom: 1rem;\n}\n\n.kc-mobile-title {\n  font-size: 2.25rem;\n  font-weight: 900;\n  letter-spacing: -0.025em;\n  margin-bottom: 0.5rem;\n  background: linear-gradient(to right, #2563eb, #1e40af);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n}\n\n.kc-mobile-tagline {\n  color: #6b7280;\n  text-align: center;\n}\n\n/* Card */\n.kc-card {\n  background: white;\n  border-radius: 1rem;\n  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);\n  padding: 2rem 2.5rem;\n}\n\n@media (min-width: 1024px) {\n  .kc-card {\n    padding: 2.5rem;\n  }\n}\n\n/* Card Header */\n.kc-card-header {\n  margin-bottom: 2rem;\n}\n\n.kc-page-title {\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: #111827;\n  margin-bottom: 0.5rem;\n}\n\n.kc-page-subtitle {\n  color: #6b7280;\n  font-size: 0.875rem;\n}\n\n/* Alerts */\n.kc-alert {\n  padding: 0.75rem 1rem;\n  margin-bottom: 1.25rem;\n  border-radius: 0.5rem;\n  font-size: 0.875rem;\n}\n\n.kc-alert-error {\n  background-color: #fef2f2;\n  border: 1px solid: #fecaca;\n  color: #dc2626;\n}\n\n.kc-alert-success {\n  background-color: #f0fdf4;\n  border: 1px solid #bbf7d0;\n  color: #16a34a;\n}\n\n.kc-alert-warning {\n  background-color: #fffbeb;\n  border: 1px solid #fef08a;\n  color: #ca8a04;\n}\n\n.kc-alert-info {\n  background-color: #eff6ff;\n  border: 1px solid #bfdbfe;\n  color: #2563eb;\n}\n\n/* Form */\n#kc-form {\n  width: 100%;\n}\n\n#kc-form-wrapper {\n  width: 100%;\n}\n\n.kc-form-group {\n  margin-bottom: 1.25rem;\n}\n\n.kc-label {\n  display: block;\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: #374151;\n  margin-bottom: 0.375rem;\n}\n\n.kc-input {\n  width: 100%;\n  border: 1px solid #d1d5db;\n  border-radius: 0.5rem;\n  padding: 0.625rem 1rem;\n  font-size: 1rem;\n  color: #111827;\n  background-color: white;\n  transition: border-color 0.2s, box-shadow 0.2s;\n}\n\n.kc-input:focus {\n  outline: none;\n  border-color: #2563eb;\n  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);\n}\n\n.kc-input::placeholder {\n  color: #9ca3af;\n}\n\n.kc-error-message {\n  display: block;\n  color: #dc2626;\n  font-size: 0.75rem;\n  margin-top: 0.25rem;\n}\n\n/* Form Options */\n.kc-form-options-wrapper {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 1rem;\n}\n\n.kc-checkbox label {\n  display: flex;\n  align-items: center;\n  font-size: 0.875rem;\n  font-weight: 400;\n  color: #374151;\n  cursor: pointer;\n}\n\n.kc-checkbox input[type=\"checkbox\"] {\n  margin-right: 0.5rem;\n  width: 1rem;\n  height: 1rem;\n  cursor: pointer;\n}\n\n.kc-forgot-password {\n  font-size: 0.875rem;\n}\n\n/* Buttons */\n.kc-form-buttons {\n  margin-top: 1.5rem;\n  margin-bottom: 0;\n}\n\n.kc-button-primary {\n  width: 100%;\n  background-color: #2563eb;\n  color: white;\n  padding: 0.875rem 1.5rem;\n  border-radius: 0.5rem;\n  font-size: 1rem;\n  font-weight: 600;\n  border: none;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.75rem;\n  box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);\n  transition: all 0.2s;\n}\n\n.kc-button-primary:hover {\n  background-color: #1d4ed8;\n  box-shadow: 0 20px 25px -5px rgba(37, 99, 235, 0.3);\n  transform: translateY(-1px);\n}\n\n.kc-button-primary:active {\n  transform: translateY(0);\n}\n\n.kc-button-primary:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n  transform: none;\n}\n\n.kc-button-icon {\n  width: 1.25rem;\n  height: 1.25rem;\n}\n\n/* Registration Link */\n.kc-registration {\n  margin-top: 2rem;\n  text-align: center;\n  font-size: 0.875rem;\n  color: #6b7280;\n}\n\n/* Security Note */\n.kc-security-note {\n  margin-top: 2rem;\n  padding-top: 1.5rem;\n  border-top: 1px solid #e5e7eb;\n  text-align: center;\n  font-size: 0.75rem;\n  color: #9ca3af;\n}\n\n/* Links */\n.kc-link {\n  color: #2563eb;\n  text-decoration: none;\n  font-weight: 600;\n  transition: color 0.2s;\n}\n\n.kc-link:hover {\n  color: #1d4ed8;\n  text-decoration: underline;\n}\n\n/* Help Link */\n.kc-help-link {\n  margin-top: 1.5rem;\n  text-align: center;\n  font-size: 0.875rem;\n  color: #9ca3af;\n}\n\n/* Info Section */\n.kc-info {\n  margin-top: 1rem;\n  padding: 0.75rem;\n  background-color: #f9fafb;\n  border-radius: 0.25rem;\n  font-size: 0.875rem;\n  color: #6b7280;\n}\n\n/* Responsive */\n@media (max-width: 640px) {\n  .kc-card {\n    padding: 1.5rem;\n  }\n\n  .kc-mobile-logo-img {\n    height: 5rem;\n    width: 5rem;\n  }\n\n  .kc-mobile-title {\n    font-size: 1.875rem;\n  }\n\n  .kc-page-title {\n    font-size: 1.25rem;\n  }\n\n  .kc-branding-logo {\n    height: 4rem;\n    width: 4rem;\n  }\n\n  .kc-branding-title {\n    font-size: 1.875rem;\n  }\n}\n"
