        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "rate(pg_stat_database_xact_commit{datname=\"buurman\"}[$__rate_interval]) + rate(pg_stat_database_xact_rollback{datname=\"buurman\"}[$__rate_interval])", "instant": true, "range": false, "legendFormat": "__auto", "refId": "A" }
