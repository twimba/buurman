{
  "private": true,
  "workspaces": [
    "app",
    "backoffice",
    "packages/*"
  ],
  "scripts": {
    "generate:api": "orval",
    "build:app": "orval && yarn workspace buurman-app build",
    "build:backoffice": "orval && yarn workspace buurman-backoffice build",
    "build": "orval && yarn workspaces foreach -A --include 'buurman-app' --include 'buurman-backoffice' run build"
  },
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "orval": "^8.5.2"
  }
}
